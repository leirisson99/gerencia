DATABASE_URL=postgresql+psycopg://gerencia:gerencia@localhost:5432/gerencia
TEST_DATABASE_URL=postgresql+psycopg://gerencia:gerencia@localhost:5432/gerencia_test
FRONTEND_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
SESSAO_DIAS_INATIVIDADE=30
LOG_LEVEL=INFO

# Administrador único, criado ou atualizado a cada início da API; o .env sempre vence.
# Gere o hash com: uv run python -m app.cli hash-senha (mantenha as aspas simples).
# ADMIN_NOME=Administrador
# ADMIN_EMAIL=admin@exemplo.com
# ADMIN_SENHA_HASH='$argon2id$...'

# Notificações push (lembretes). Sem as chaves, o push fica desligado.
# Gere uma vez com: uv run python -m app.cli gerar-chaves-vapid (trocar invalida os aparelhos já ativados).
# VAPID_CHAVE_PUBLICA=
# VAPID_CHAVE_PRIVADA=
# VAPID_CONTATO=mailto:voce@exemplo.com
